# Camera credentials
USERNAME=your_rtsp_username
PASSWORD=your_rtsp_password
IPADDRESS=192.168.1.100
CHANNEL=1
SUBTYPE=0

# Camera resolution (original from camera)
ORIG_W=3840
ORIG_H=2160

# Processing resolution (scaled for inference)
IMG_W=1280
IMG_H=720

# Detection confidence threshold (0.0-1.0)
CONF_THRESH=0.5

# Detection zones in ORIGINAL resolution coordinates
# Exit zone: top portion of frame (cars leaving)
EXIT_ZONE=[,,,]

# Entry zone: bottom portion of frame (cars arriving)
ENTRY_ZONE=[,,,]

# Reports output directory
REPORT_DIR=./reports