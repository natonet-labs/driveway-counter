# Camera credentials
USERNAME=your_username
PASSWORD=your_password
IPADDRESS=192.168.1.100
CHANNEL=1
SUBTYPE=1

# Original camera resolution (depends on subtype=1 or 0)
ORIG_W=704
ORIG_H=480

# Processing resolution
IMG_W=704
IMG_H=480

# Detection confidence threshold (lower = more detections, more false positives).
# 0.65 is the tuned default — see docs/tuning-guide.md. Values below ~0.50 produce
# frequent false positives on foliage and shadows.
CONF_THRESH=0.65

# Minimum bounding box area in px² — filters out tiny false positives
# (leaves, insects, dust). ~2500 px² is a small cat; ~10000 px² is a vehicle.
MIN_BBOX_AREA=2500

# Minimum horizontal pixel displacement per frame to register a zone crossing.
# Prevents stationary jitter from generating false counts.
VELOCITY_THRESHOLD=5

# SINGLE TRACKING ZONE (top-left, top-right, bottom-right, bottom-left)
TRACKING_ZONE=[[x,y],[x,y],[x,y],[x,y]]

# Reports output directory
REPORT_DIR=./reports

# Detection watchdog — if Tracks=0 for this many seconds, restart the service.
# Set to 0 to disable.
WATCHDOG_TIMEOUT_SEC=300

# Frame watchdog — if no frame is delivered at all for this many seconds,
# restart the service. Catches a fully wedged pipeline (e.g. an RTSP session
# that hangs without a clean disconnect). Set to 0 to disable.
FRAME_STALL_TIMEOUT_SEC=60

ISDEBUG=False

# Cloudflare metrics (optional — leave blank to disable)
WORKER_URL=
CLOUDFLARE_TOKEN=